# Ludex — örnek environment dosyası (Aşama 2: yerel backend altyapısı)
#
# Bu dosya yalnızca LOCAL DEVELOPMENT için örnek ve güvenli değerler içerir.
# Aşağıdaki değerler gerçek bir secret veya production şifresi DEĞİLDİR.
#
# Kullanım:
#   cp .env.example .env
# .env, hem Next.js hem de Docker Compose tarafından okunan ortak dosyadır
# (Docker Compose varsayılan olarak .env'i otomatik yükler; Next.js de .env'i
# okuyabilir). .gitignore ile izlenmez, asla commit etmeyin.
# Production'da tüm değerler (özellikle POSTGRES_PASSWORD ve AUTH_SECRET)
# benzersiz, rastgele üretilmiş gerçek değerlerle değiştirilmelidir.

# --- PostgreSQL (Docker Compose: postgres servisi) --------------------------
# POSTGRES_PORT: host makinede yayınlanan port. Bilgisayarda başka bir
# PostgreSQL zaten 5432'yi kullanıyor olabileceğinden varsayılan 5433'tür.
# Container içinde PostgreSQL her zaman 5432 portunu dinler.
POSTGRES_DB=ludex_dev
POSTGRES_USER=ludex_dev
POSTGRES_PASSWORD=ludex_dev_only_change_me
POSTGRES_PORT=5433

# DATABASE_URL: host makinede npm run dev ile çalışan Next.js uygulamasının
# Docker içindeki PostgreSQL'e localhost:5433 üzerinden bağlandığı örnek.
DATABASE_URL="postgresql://ludex_dev:ludex_dev_only_change_me@localhost:5433/ludex_dev?schema=public"

# --- Mailpit (Docker Compose: mailpit servisi) -------------------------------
# MAIL_HOST/MAIL_PORT: host makinedeki uygulamanın Mailpit'in SMTP portuna
# (container: 1025) bağlanacağı adres.
# MAIL_USER/MAIL_PASSWORD: Mailpit varsayılan olarak kimlik doğrulama
# gerektirmez; bu nedenle boş bırakılabilir, zorunlu değildir.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Ludex Dev <dev@ludex.local>"

# Mailpit web arayüzü portu (http://localhost:8025) — compose.yaml tarafından
# okunur, uygulama tarafından kullanılmaz.
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# --- Uygulama -----------------------------------------------------------------
# APP_URL: yalnızca R2 tanımlı değilken (yerel dosya depolama) yükleme ve
# görüntüleme URL'lerini oluşturmak için kullanılır; tanımlı değilse
# http://localhost:3000 varsayılır.
APP_URL=http://localhost:3000

# AUTH_SECRET: oturum/token imzalama anahtarı örneği. Bu DEĞER GERÇEK BİR
# SECRET DEĞİLDİR — yalnızca local development içindir. Production'da
# `openssl rand -base64 32` gibi bir komutla üretilen benzersiz bir değerle
# değiştirilmelidir.
AUTH_SECRET=dev_only_local_secret_replace_before_any_shared_use

# --- Cloudflare Workers AI (rapor değerlendirme) -----------------------------
# Cloudflare dashboard > My Profile > API Tokens (CLOUDFLARE_API_TOKEN) ve
# dashboard ana sayfasındaki Account ID (CLOUDFLARE_ACCOUNT_ID) üzerinden
# alınır. AI ekibinde (Üye 1) zaten mevcut olmalı — onlardan isteyin. Tanımlı
# değilse /api/reports/:id/evaluate net bir hata mesajıyla başarısız olur
# (sessizce bozulmaz).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Cloudflare R2 (dosya depolama) ------------------------------------------
# Cloudflare dashboard > R2 > Manage API Tokens üzerinden alınır. Geliştirme
# ortamında (NODE_ENV production değilse) bu değerler boş bırakılırsa sistem
# otomatik olarak yerel dosya sistemi tabanlı depolamaya düşer
# (/api/local-storage/[...key]) — rapor yükleme akışı R2 olmadan da tamamen
# çalışır. Production'da ise eksikse sessizce yerel depolamaya geçilmez, açık
# bir yapılandırma hatası fırlatılır (bkz. src/lib/storage/index.ts).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- LlamaParse (PDF -> metin çıkarma) ---------------------------------------
# cloud.llamaindex.ai üzerinden alınan gerçek bir API anahtarıdır, boş
# bırakılamaz bir örnek değeri yoktur. Tanımlı değilse sistem otomatik olarak
# yerel, ücretsiz bir gerçek PDF metin çıkarıcıya (pdfjs-dist tabanlı
# LocalPdfTextExtractor) düşer (bkz. src/lib/text-extraction/index.ts) —
# geliştirme akışı bu anahtar olmadan da gerçek metinle tamamen çalışır, mock/
# sahte bir içerik üretilmez.
LLAMA_CLOUD_API_KEY=
