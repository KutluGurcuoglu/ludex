generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  JUDGE
  CONTESTANT
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JudgeWorkStatus {
  WORKING
  STUDYING
  BOTH
}

enum ReportStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  IN_REVIEW
  COMPLETED
  DISQUALIFIED
}

enum EvaluationStatus {
  DRAFT
  SUBMITTED
}

enum DisqualificationDecision {
  UPHELD
  DISMISSED
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                       String             @id @default(uuid())
  email                    String             @unique
  passwordHash             String
  fullName                 String
  phone                    String
  phoneNormalized          String             @unique
  role                     Role               @default(CONTESTANT)
  judgeApprovalStatus      ApplicationStatus?
  judgeWorkStatus          JudgeWorkStatus?
  jobTitle                 String?
  department               String?
  expertiseArea            String?
  academicProfileUrl       String?
  cvFileName               String?
  customExpertiseTags      String[]           @default([])
  judgeAgreementAcceptedAt DateTime?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  judgeApplication    JudgeApplication?
  judgeCategories     JudgeCategory[]
  reports             Report[]                @relation("ContestantReports")
  judgeAssignments    ReportJudgeAssignment[]
  judgeEvaluations    JudgeEvaluation[]
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@index([email])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model JudgeApplication {
  id        String            @id @default(uuid())
  userId    String            @unique
  status    ApplicationStatus @default(PENDING)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id                 String    @id @default(uuid())
  name               String    @unique
  slug               String    @unique
  description        String?
  specification      Json?
  specificationText  String?
  reportTemplate     Json?
  templateSections   Json      @default("[]")
  evaluationCriteria Json      @default("[]")
  criteria           Json      @default("[]")
  submissionOpensAt  DateTime?
  submissionClosesAt DateTime?
  resultsReleaseAt   DateTime?
  resultsReleasedAt  DateTime?
  evaluationDeadline DateTime?
  createdAt          DateTime  @default(now())

  judgeCategories JudgeCategory[]
  reports         Report[]
}

model JudgeCategory {
  userId     String
  categoryId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
}

model ScoreCriterion {
  id          String   @id @default(uuid())
  label       String   @unique
  maxScore    Float
  description String?
  createdAt   DateTime @default(now())
}

model Report {
  id            String       @id @default(uuid())
  title         String
  contestantId  String
  categoryId    String
  fileName      String
  fileSize      Int
  r2Key         String
  extractedText String?
  extractedPages Json?
  status        ReportStatus @default(PENDING_ASSIGNMENT)
  assignedAt    DateTime?
  submittedAt   DateTime     @default(now())

  contestant User     @relation("ContestantReports", fields: [contestantId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  judgeAssignments ReportJudgeAssignment[]
  aiAnalysis       AIAnalysis?
  judgeEvaluations JudgeEvaluation[]
  notifications    Notification[]

  @@index([contestantId])
  @@unique([contestantId, categoryId])
}

model ReportJudgeAssignment {
  reportId   String
  judgeId    String
  assignedAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  judge  User   @relation(fields: [judgeId], references: [id], onDelete: Cascade)

  @@id([reportId, judgeId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  kind      String
  title     String
  body      String?
  link      String?
  reportId  String?
  createdAt DateTime @default(now())
  readAt    DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report? @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, reportId])
  @@index([userId, createdAt])
}

model AIAnalysis {
  id        String   @id @default(uuid())
  reportId  String   @unique
  result    Json
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model JudgeEvaluation {
  id                  String           @id @default(uuid())
  reportId            String
  judgeId             String
  overallComment      String
  totalScore          Float
  status              EvaluationStatus @default(DRAFT)
  visibleToContestant Boolean          @default(false)

  disqualificationFindingId      String?
  disqualificationRuleText       String?
  disqualificationFindingText    String?
  disqualificationEvidenceId     String?
  disqualificationDecidedAt      DateTime?
  disqualificationAdminDecision  DisqualificationDecision?
  disqualificationAdminDecidedAt DateTime?

  updatedAt DateTime @updatedAt

  report Report           @relation(fields: [reportId], references: [id], onDelete: Cascade)
  judge  User             @relation(fields: [judgeId], references: [id], onDelete: Cascade)
  scores CriterionScore[]

  @@unique([reportId, judgeId])
}

model CriterionScore {
  id           String  @id @default(uuid())
  evaluationId String
  // getEffectiveCriteria() ile aynı kural: ya global ScoreCriterion.id ya da
  // bir Category.criteria[].id — ikisi de aynı tabloda değil, bu yüzden burada
  // kasıtlı olarak bir FK yok; geçerliliği route katmanı (getEffectiveCriteria)
  // zaten kontrol ediyor.
  criterionId  String
  score        Float
  comment      String?

  evaluation JudgeEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterionId])
}

model EmailOutbox {
  id        String       @id @default(uuid())
  to        String
  subject   String
  body      String
  status    OutboxStatus @default(PENDING)
  createdAt DateTime     @default(now())
  sentAt    DateTime?
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  details   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
